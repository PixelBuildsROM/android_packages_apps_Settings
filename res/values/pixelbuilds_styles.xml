<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Styles -->
    <style name="pbTextPrimary">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamily</item>
    </style>
    <style name="pbTextPrimaryMedium" parent="pbTextPrimary">
        <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
    </style>
    <style name="pbTextSecondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <!-- Preferences -->
    <!-- General -->
    <style name="pbPreferenceBase">
        <item name="android:layout_marginStart">@dimen/pb_pref_horizontal_padding</item>
        <item name="android:layout_marginEnd">@dimen/pb_pref_horizontal_padding</item>
        <item name="android:clipToPadding">false</item>
    </style>
    <style name="pbPreferenceTop" parent="pbPreferenceBase">
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/pixelbuilds_preference_background_top</item>
    </style>
    <style name="pbPreferenceMiddle" parent="pbPreferenceBase">
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/pixelbuilds_preference_background_middle</item>
    </style>
    <style name="pbPreferenceBottom" parent="pbPreferenceBase">
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/pixelbuilds_preference_background_bottom</item>
    </style>
    <!-- Dashboard -->
    <style name="pbDashboardPreferenceTop" parent="pbPreferenceTop">
        <item name="android:layout_marginTop">@dimen/pb_pref_horizontal_padding</item>
    </style>
    <style name="pbDashboardPreferenceBottom" parent="pbPreferenceBottom">
        <item name="android:layout_marginBottom">0dp</item>
    </style>
</resources>