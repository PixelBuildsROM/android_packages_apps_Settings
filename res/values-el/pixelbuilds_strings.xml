    <string name="wifi_hotspot_block_client_dialog_text">Αυτή η ενέργεια θα αποσυνδέσει το \"<xliff:g id="device_name">%1$s</xliff:g>\" από αυτήν τη συσκευή και θα το προσθέσει στη λίστα αποκλεισμού</string>
